POSTGRES_USER=tennisly
POSTGRES_PASSWORD=tennisly_dev
POSTGRES_DB=tennisly
# Tennisly-owned host port block (avoids clashing with other local stacks).
# `make up` runs scripts/allocate-ports.sh — if a preferred port is busy it
# picks the next free one and writes .run/ports.env.
POSTGRES_PORT=15432
REDIS_PORT=16379
KAFKA_EXTERNAL_PORT=19094
PGADMIN_EMAIL=admin@tennisly.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=15050
REDIS_COMMANDER_PORT=18081
KAFKA_UI_PORT=18082
ELASTICSEARCH_PORT=19200
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
EUREKA_SERVER_PORT=18761
TENNIS_DATA_SERVER_PORT=18083
MATCH_SERVER_PORT=18084
REPLAY_SERVER_PORT=18085
ANALYTICS_SERVER_PORT=18086
WEB_PORT=13000
# tennis-data-service fails fast without both keys
TENNIS_BALLDONTLIE_API_KEY=
TENNIS_LIVETENNIS_API_KEY=
TENNIS_DATA_PROVIDER=balldontlie
# Free-tier friendly page size; lower if BallDontLie rejects 100 after downgrade
TENNIS_BALLDONTLIE_PER_PAGE=100
MATCH_INGEST_ENABLED=true
# Gateway (local defaults; set real origins + fail-closed when using SPRING_PROFILES_ACTIVE=prod)
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_FAIL_OPEN=true
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
