# Render / JVM secrets for Phase 8a (also set via render.yaml sync:false prompts)
# See docs/deploy.md

TENNIS_BALLDONTLIE_API_KEY=
TENNIS_LIVETENNIS_API_KEY=

# After Blueprint create: paste public tennis-data URL into match-service
TENNIS_DATA_SERVICE_URI=https://tennis-data-service-xxxx.onrender.com

# Include every Vercel origin that may open match WS (comma-separated)
MATCH_SERVICE_WS_ALLOWED_ORIGINS=https://tennisly.vercel.app,http://localhost:3000

EUREKA_CLIENT_ENABLED=false
MANAGEMENT_HEALTH_KAFKA_ENABLED=false

# Bind to Render-assigned port in native runtime; Dockerfiles use SERVER_PORT=10000 + map
# SERVER_PORT=10000
