# Render / JVM secrets for Phase 8a (also set via render.yaml sync:false prompts)
# See docs/deploy.md
#
# Domain: tennisly.tv (Vercel) · api.tennisly.tv (gateway, optional CNAME later)

TENNIS_BALLDONTLIE_API_KEY=
TENNIS_LIVETENNIS_API_KEY=

# Same random value on api-gateway + tennis-data + match (openssl rand -hex 32)
GATEWAY_INTERNAL_TOKEN=

# External Postgres (Neon) — Render's free database is deleted after 30 days.
POSTGRES_HOST=ep-xxxx-pooler.eu-west-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL_PARAMS=?sslmode=require
POSTGRES_POOL_MAX=5

# After Blueprint create: paste public tennis-data / match URLs into the gateway
TENNIS_DATA_SERVICE_URI=https://tennis-data-service-xxxx.onrender.com
MATCH_SERVICE_URI=https://match-service-xxxx.onrender.com
MATCH_SERVICE_WS_URI=https://match-service-xxxx.onrender.com
AUTH_SERVICE_URI=https://auth-service-xxxx.onrender.com
USER_SERVICE_URI=https://user-service-xxxx.onrender.com
USER_SERVICE_ROUTE_URI=https://user-service-xxxx.onrender.com

# match-service also calls tennis-data for ingest (same URI + shared token)
# TENNIS_DATA_SERVICE_URI above is reused by match-service.

# Clerk → gateway → auth-service (svix secret from Clerk webhook endpoint)
CLERK_WEBHOOK_SECRET=whsec_...

# AES-256 key for user-service webhook endpoint secrets (openssl rand -base64 32)
WEBHOOK_ENCRYPTION_KEY=

# Clerk resource-server validation on the gateway
CLERK_JWKS_URI=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER_URI=https://YOUR_INSTANCE.clerk.accounts.dev

CORS_ALLOWED_ORIGINS=https://tennisly.tv,https://www.tennisly.tv
MATCH_SERVICE_WS_ALLOWED_ORIGINS=https://tennisly.tv,https://www.tennisly.tv,http://localhost:3000

EUREKA_CLIENT_ENABLED=false
CONFIG_SERVER_ENABLED=false
GATEWAY_DISCOVERY_LOCATOR_ENABLED=false
MANAGEMENT_HEALTH_KAFKA_ENABLED=false

# Render injects PORT; the image entrypoint binds -Dserver.port=${PORT:-10000}.
