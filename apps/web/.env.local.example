NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
# Optional: existing Clerk user for authenticated Playwright (prefer +clerk_test inbox)
# E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
# Server-only BFF upstreams (make up exports these from .run/ports.env;
# keep these as fallbacks when running Next without the Makefile)
MATCH_SERVICE_URL=http://localhost:18084
TENNIS_DATA_SERVICE_URL=http://localhost:18083
REPLAY_SERVICE_URL=http://localhost:18085
ANALYTICS_SERVICE_URL=http://localhost:18086
# Optional until Phase 8b
# USER_SERVICE_URL=http://localhost:8082
# NOTIFICATION_SERVICE_URL=http://localhost:18087
# PORT=13000
# Required by tennis-data-service (fail-fast if missing) — set in the JVM env, not the browser
# TENNIS_BALLDONTLIE_API_KEY=
# TENNIS_LIVETENNIS_API_KEY=
# TENNIS_BALLDONTLIE_PER_PAGE=100
# Production: see apps/web/.env.production.example and docs/deploy.md
