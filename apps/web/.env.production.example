# Vercel production / preview env for @tennisly/web
# Set in Vercel → Project → Settings → Environment Variables
# Custom domain: tennisly.tv (Clerk dashboard must allow the same origins)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Phase 8a: both point at the public api-gateway (not the locked backend URLs).
# Paths differ (/api/matches vs /api/tennis) so one gateway base serves both.
MATCH_SERVICE_URL=https://api-gateway-xxxx.onrender.com
TENNIS_DATA_SERVICE_URL=https://api-gateway-xxxx.onrender.com
# After DNS: MATCH_SERVICE_URL=https://api.tennisly.tv

# Phase 8b: admin BFF + preferences go through the gateway (/api/users/**).
# Do not point this at user-service.onrender.com — that host requires the
# internal token, which the Vercel app must not hold.
USER_SERVICE_URL=https://api-gateway-xxxx.onrender.com
# Same gateway host — /api/notifications/** is routed there. Do not point this
# at notification-service.onrender.com (that host requires the internal token).
NOTIFICATION_SERVICE_URL=https://api-gateway-xxxx.onrender.com
# Phase 8c: same gateway host — /api/analytics/** is routed there. Do not point
# this at analytics-service.onrender.com (that host requires the internal token).
# ANALYTICS_SERVICE_URL=https://api-gateway-xxxx.onrender.com
# Optional until replay objects land on R2
# REPLAY_SERVICE_URL=https://api-gateway-xxxx.onrender.com

# Browser → gateway WebSocket (match centre). Space-separated.
# CSP_CONNECT_SRC_EXTRA=https://api-gateway-xxxx.onrender.com wss://api-gateway-xxxx.onrender.com
# After DNS: CSP_CONNECT_SRC_EXTRA=https://api.tennisly.tv wss://api.tennisly.tv
