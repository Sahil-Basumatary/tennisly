# Vercel production / preview env for @tennisly/web
# Set in Vercel → Project → Settings → Environment Variables
# Custom domain: tennisly.tv (Clerk dashboard must allow the same origins)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Phase 8a: both point at the public api-gateway (not the locked backend URLs).
# Paths differ (/api/matches vs /api/tennis) so one gateway base serves both.
MATCH_SERVICE_URL=https://api-gateway-xxxx.onrender.com
TENNIS_DATA_SERVICE_URL=https://api-gateway-xxxx.onrender.com
# After DNS: MATCH_SERVICE_URL=https://api.tennisly.tv

# Optional until Phase 8b/8c
# REPLAY_SERVICE_URL=https://replay-service-xxxx.onrender.com
# ANALYTICS_SERVICE_URL=https://analytics-service-xxxx.onrender.com
# USER_SERVICE_URL=https://user-service-xxxx.onrender.com
# NOTIFICATION_SERVICE_URL=https://notification-service-xxxx.onrender.com

# Browser → gateway WebSocket (match centre). Space-separated.
# CSP_CONNECT_SRC_EXTRA=https://api-gateway-xxxx.onrender.com wss://api-gateway-xxxx.onrender.com
# After DNS: CSP_CONNECT_SRC_EXTRA=https://api.tennisly.tv wss://api.tennisly.tv
