# Vercel production / preview env for @tennisly/web
# Set in Vercel → Project → Settings → Environment Variables

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Public HTTPS Render service bases (no trailing slash)
MATCH_SERVICE_URL=https://match-service-xxxx.onrender.com
TENNIS_DATA_SERVICE_URL=https://tennis-data-service-xxxx.onrender.com

# Optional until Phase 8b/8c
# REPLAY_SERVICE_URL=https://replay-service-xxxx.onrender.com
# ANALYTICS_SERVICE_URL=https://analytics-service-xxxx.onrender.com
# USER_SERVICE_URL=https://user-service-xxxx.onrender.com
# NOTIFICATION_SERVICE_URL=https://notification-service-xxxx.onrender.com

# Space-separated extra CSP connect-src hosts (e.g. Render WS later)
# CSP_CONNECT_SRC_EXTRA=https://match-service-xxxx.onrender.com wss://match-service-xxxx.onrender.com
